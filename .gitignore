# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# script caches (ephemeral, not needed in git)
.cache/
# per-run enrichment detail logs (see scripts/lib/progress-log.mjs)
/logs/
scripts/*-cache.json

# Generated spreadsheets — review sheets, audit trails, ambiguity reports,
# failure dumps. These belong OUTSIDE the repo, in
#   /Users/maisiebird/Claude/Projects/Rebalance Gender/output files
# (see documentation/OUTPUT-FILE-LOCATION-PROPOSAL.md). Nothing in this repo
# is meant to be a .csv or .ods, so the blanket ignore is the safety net that
# stops a stray run from re-littering the tree — every previous entry here was
# a per-script pattern added after the fact, always one script behind.
*.csv
*.ods
# LibreOffice lock files left next to an open spreadsheet
.~lock.*#
# still written here by scripts that have not moved yet
/outputs/
__pycache__/
*.pyc

# temporary scripts
_tmp_*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# supabase CLI (ephemeral local/link state; keep config.toml + migrations)
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local state — settings, agents, and the worktrees it creates
# (those are checkouts of this same repo, so committing them would nest
# a git repository inside itself)
.claude/
