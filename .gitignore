# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# script caches (ephemeral, not needed in git)
.cache/
# per-run enrichment detail logs (see scripts/lib/progress-log.mjs)
/logs/
scripts/*-cache.json

# NOTE: generated spreadsheets are deliberately NOT ignored here.
# Every script writes its .csv/.ods OUTSIDE the repo, to the `output files/`
# folder beside the checkout, via scripts/lib/output-path.mjs — so there is
# nothing to ignore. If a spreadsheet ever does appear in the tree, that is
# a script that regressed, and it should show up in `git status` rather than
# be hidden. Keeping the rules off also means a .csv that genuinely belongs
# in the repo (a test fixture, say) can be committed without `git add -f`.

# LibreOffice lock files left next to an open spreadsheet
.~lock.*#
__pycache__/
*.pyc

# temporary scripts
_tmp_*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# supabase CLI (ephemeral local/link state; keep config.toml + migrations)
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# claude local state — settings, agents, and the worktrees it creates
# (those are checkouts of this same repo, so committing them would nest
# a git repository inside itself)
.claude/
