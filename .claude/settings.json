{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/git-hooks/guard-branch.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch"
          }
        ]
      }
    ]
  }
}
